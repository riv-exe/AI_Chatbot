<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Mobilechatbot"
        parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Blue shades for dark mode -->
        <item name="colorPrimary">@color/blue_light</item>
        <item name="colorPrimaryVariant">@color/blue_primary</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Yellow shades for dark mode -->
        <item name="colorSecondary">@color/yellow_light</item>
        <item name="colorSecondaryVariant">@color/yellow_primary</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Background & Surface - Dark -->
        <item name="android:windowBackground">@color/black_soft</item>
        <item name="android:colorBackground">@color/black_soft</item>
        <item name="colorSurface">@color/gray_dark</item>
        <item name="colorOnSurface">@color/white</item>
        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/blue_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/black_soft</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    </resources>